  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:           #020204;
      --surface:      rgba(255,255,255,0.02);
      --accent:       #6366f1;
      --accent-soft:  rgba(99,102,241,0.10);

      /* Consensus identity — Lime Green: scientific rigour, verified evidence, precision */
      --li:           #84cc16;
      --li-light:     #a3e635;
      --li-pale:      #ecfccb;
      --li-soft:      rgba(132,204,22,0.08);
      --li-mid:       rgba(132,204,22,0.20);
      --li-glow:      rgba(132,204,22,0.35);
      --li-dark:      #65a30d;

      --text:         #e8e8f0;
      --text-soft:    #b0b0c8;
      --muted:        #6b6b80;
      --border:       rgba(255,255,255,0.05);
      --border-hover: rgba(132,204,22,0.32);
      --radius:       16px;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 16px;
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* ── STARFIELD ─────────────────────────── */
    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        radial-gradient(1px   1px   at  7%  14%, rgba(255,255,255,0.52) 0%, transparent 100%),
        radial-gradient(1px   1px   at 25%  63%, rgba(255,255,255,0.28) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 52%   8%, rgba(255,255,255,0.56) 0%, transparent 100%),
        radial-gradient(1px   1px   at 76%  42%, rgba(255,255,255,0.32) 0%, transparent 100%),
        radial-gradient(1px   1px   at 90%  77%, rgba(255,255,255,0.20) 0%, transparent 100%),
        radial-gradient(1px   1px   at 42%  87%, rgba(132,204,22,0.28)  0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 17%  50%, rgba(255,255,255,0.40) 0%, transparent 100%),
        radial-gradient(1px   1px   at 65%  26%, rgba(163,230,53,0.20)  0%, transparent 100%),
        radial-gradient(1px   1px   at 34%  45%, rgba(255,255,255,0.30) 0%, transparent 100%),
        radial-gradient(1px   1px   at 81%  17%, rgba(132,204,22,0.18)  0%, transparent 100%);
    }

    /* lime nebula */
    body::after {
      content: '';
      position: fixed; top: -18vh; left: 50%; transform: translateX(-50%);
      width: 88vw; height: 62vh; z-index: 0; pointer-events: none;
      background:
        radial-gradient(ellipse at 37% 50%, rgba(132,204,22,0.06) 0%, transparent 58%),
        radial-gradient(ellipse at 67% 50%, rgba(99,102,241,0.05) 0%, transparent 55%);
    }

    /* ── NAV ───────────────────────────────── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 52px;
      background: rgba(2,2,4,0.82);
      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none; color: var(--text); font-size: 0.95rem; font-weight: 700;
    }
    .nav-logo .orb {
      width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
      background: radial-gradient(circle at 35% 35%, #818cf8, #4f46e5);
      box-shadow: 0 0 14px rgba(99,102,241,0.7);
    }
    .nav-back {
      font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--muted);
      text-decoration: none; transition: color 0.25s;
    }
    .nav-back:hover { color: var(--li-light); }

    /* ── HERO ──────────────────────────────── */
    .hero {
      position: relative; z-index: 1;
      padding: 160px 52px 80px;
      max-width: 1100px; margin: 0 auto;
      display: grid; grid-template-columns: 1fr 340px;
      gap: 64px; align-items: center;
      animation: fadeUp 0.6s ease both;
    }
    .hero-breadcrumb {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--li-light); margin-bottom: 20px;
    }
    .hero-breadcrumb span { color: var(--muted); }

    .identity-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--li-soft); border: 1px solid var(--li-mid);
      border-radius: 100px; padding: 5px 14px;
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--li-pale); margin-bottom: 20px;
    }

    /* DNA double-helix pulse — science identity */
    .dna-icon { display: inline-block; animation: dnaPulse 2.4s ease-in-out infinite; }
    @keyframes dnaPulse {
      0%,100% { transform: scaleY(1);    opacity: 1;    }
      30%      { transform: scaleY(1.4); opacity: 0.85; }
      60%      { transform: scaleY(0.8); opacity: 0.95; }
    }

    .hero h1 {
      font-size: clamp(2.2rem, 4.5vw, 3.6rem);
      font-weight: 800; letter-spacing: -0.035em;
      line-height: 1.08; margin-bottom: 24px;
    }
    .hero h1 em {
      font-style: normal;
      background: linear-gradient(135deg, #ecfccb 0%, #84cc16 45%, #65a30d 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-sub {
      font-size: 1.05rem; color: var(--text-soft);
      max-width: 520px; line-height: 1.75; margin-bottom: 36px;
    }

    .hero-tags { display: flex; flex-wrap: wrap; gap: 10px; }
    .tag {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--li-soft); border: 1px solid var(--li-mid);
      border-radius: 100px; padding: 5px 14px;
      font-size: 0.72rem; font-weight: 600; color: var(--li-pale); letter-spacing: 0.06em;
    }
    .tag.indigo { background: var(--accent-soft); border-color: rgba(99,102,241,0.2); color: #a5b4fc; }
    .tag.amber  { background: rgba(245,158,11,0.07); border-color: rgba(245,158,11,0.18); color: #fcd34d; }

    /* ── SCORE CARD ────────────────────────── */
    .score-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 24px; padding: 36px 32px;
      text-align: center; backdrop-filter: blur(12px);
      position: relative; overflow: hidden;
    }
    .score-card::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 0%, rgba(132,204,22,0.09), transparent 60%);
      pointer-events: none;
    }
    .type-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--li-soft); border: 1px solid var(--li-mid);
      border-radius: 100px; padding: 4px 12px;
      font-size: 0.64rem; font-weight: 700; letter-spacing: 0.1em;
      color: var(--li-pale); text-transform: uppercase; margin-bottom: 18px;
    }
    .score-ring {
      width: 110px; height: 110px; border-radius: 50%;
      background: conic-gradient(#84cc16 0% 91%, rgba(255,255,255,0.05) 91% 100%);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px; position: relative;
    }
    .score-ring::after {
      content: ''; position: absolute; inset: 8px;
      background: #040901; border-radius: 50%;
    }
    .score-number {
      position: relative; z-index: 1; font-size: 1.8rem; font-weight: 800;
      background: linear-gradient(135deg, #ecfccb, #84cc16);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .score-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 24px; }
    .score-rows { display: flex; flex-direction: column; gap: 12px; }
    .score-row  { display: flex; align-items: center; gap: 12px; }
    .score-row-label { font-size: 0.75rem; color: var(--muted); font-weight: 500; flex: 1; text-align: left; }
    .score-bar-track { flex: 2; height: 4px; border-radius: 4px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .score-bar-fill  { height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--li-dark), var(--li)); }
    .score-val { font-size: 0.72rem; font-weight: 700; color: var(--li-light); width: 28px; text-align: right; }

    /* ── PAGE BODY ─────────────────────────── */
    .page-body {
      position: relative; z-index: 1; max-width: 1100px; margin: 0 auto;
      padding: 0 52px 120px; display: grid; grid-template-columns: 1fr 300px;
      gap: 64px; align-items: start;
    }
    .side-col { position: sticky; top: 100px; }

    /* ── CONTENT ───────────────────────────── */
    .content-section { margin-bottom: 64px; animation: fadeUp 0.6s ease both; }
    .section-eyebrow { display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--li-light); margin-bottom: 14px; }
    .content-section h2 { font-size: clamp(1.4rem, 2.5vw, 1.9rem); font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin-bottom: 20px; }
    .content-section p { color: var(--text-soft); margin-bottom: 18px; font-size: 0.97rem; line-height: 1.8; }
    .content-section p strong { color: var(--text); font-weight: 600; }
    .divider { height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); margin: 48px 0; }

    /* ── VERDICT BOX ───────────────────────── */
    .verdict-box {
      background: var(--li-soft);
      border: 1px solid rgba(132,204,22,0.14);
      border-left: 3px solid var(--li);
      border-radius: var(--radius);
      padding: 32px 30px; margin-bottom: 32px;
      position: relative; overflow: hidden;
    }
    .verdict-box::before {
      content: '✦ EXPERT VERDICT'; position: absolute; top: 18px; right: 20px;
      font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em;
      color: rgba(132,204,22,0.30);
    }
    .verdict-box p { font-size: 1.05rem; color: var(--text); font-style: italic; line-height: 1.75; margin: 0; }

    /* ── CONSENSUS METER VISUAL ────────────── */
    .meter-demo {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 28px 26px; margin: 28px 0;
      position: relative; overflow: hidden;
    }
    .meter-demo::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--li), transparent);
    }
    .meter-label {
      font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--muted); margin-bottom: 20px;
    }
    .meter-question {
      font-size: 0.95rem; font-weight: 700; color: var(--text);
      margin-bottom: 18px; font-style: italic;
    }
    .meter-bar-wrap { margin-bottom: 10px; }
    .meter-bar-label {
      display: flex; justify-content: space-between;
      font-size: 0.72rem; color: var(--muted); margin-bottom: 6px;
    }
    .meter-track {
      height: 10px; border-radius: 10px; background: rgba(255,255,255,0.05);
      overflow: hidden; display: flex;
    }
    .meter-yes  { background: linear-gradient(90deg, #65a30d, #84cc16); border-radius: 10px 0 0 10px; }
    .meter-no   { background: rgba(248,113,113,0.55); border-radius: 0 10px 10px 0; }
    .meter-foot { font-size: 0.72rem; color: var(--muted); margin-top: 14px; line-height: 1.6; }
    .meter-foot strong { color: var(--li-light); }

    /* ── STAT STRIP ────────────────────────── */
    .stat-strip {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 12px; margin: 28px 0;
    }
    .stat-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; padding: 20px 14px; text-align: center;
      transition: border-color 0.3s;
    }
    .stat-card:hover { border-color: rgba(132,204,22,0.28); }
    .stat-num {
      font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em;
      background: linear-gradient(135deg, #ecfccb, #84cc16);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; line-height: 1.1;
    }
    .stat-label { font-size: 0.66rem; color: var(--muted); margin-top: 6px; line-height: 1.4; }

    /* ── HOW IT WORKS FLOW ─────────────────── */
    .flow-strip {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 26px 24px; margin: 24px 0;
    }
    .flow-label {
      font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--muted); margin-bottom: 18px;
    }
    .flow-steps { display: flex; align-items: center; flex-wrap: nowrap; overflow-x: auto; }
    .flow-step  { display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1; min-width: 80px; text-align: center; }
    .flow-node  {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; border: 1px solid;
    }
    .fn-q  { background: rgba(132,204,22,0.10); border-color: rgba(132,204,22,0.30); }
    .fn-s  { background: rgba(99,102,241,0.10);  border-color: rgba(99,102,241,0.30);  }
    .fn-a  { background: rgba(245,158,11,0.08);  border-color: rgba(245,158,11,0.25);  }
    .fn-m  { background: rgba(52,211,153,0.08);  border-color: rgba(52,211,153,0.25);  }
    .fn-r  { background: rgba(132,204,22,0.12);  border-color: rgba(132,204,22,0.30);  }
    .flow-name  { font-size: 0.62rem; color: var(--muted); font-weight: 600; line-height: 1.3; }
    .flow-arrow { color: rgba(132,204,22,0.50); font-size: 0.9rem; flex-shrink: 0; position: relative; top: -12px; padding: 0 2px; }

    /* ── USE CASES ─────────────────────────── */
    .use-cases { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
    .use-case-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 22px 20px;
      transition: border-color 0.3s, transform 0.3s;
    }
    .use-case-card:hover { border-color: rgba(132,204,22,0.30); transform: translateY(-3px); }
    .use-case-icon  { font-size: 1.4rem; margin-bottom: 10px; }
    .use-case-title { font-size: 0.85rem; font-weight: 700; margin-bottom: 8px; }
    .use-case-desc  { font-size: 0.78rem; color: var(--muted); line-height: 1.6; }

    /* ── FEATURE LIST ──────────────────────── */
    .feature-list { list-style: none; display: flex; flex-direction: column; gap: 16px; margin-top: 16px; }
    .feature-list li { display: grid; grid-template-columns: 36px 1fr; gap: 14px; align-items: start; }
    .feature-icon {
      width: 36px; height: 36px; border-radius: 10px;
      background: var(--li-soft); border: 1px solid var(--li-mid);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem; flex-shrink: 0;
    }
    .feature-text strong { display: block; font-size: 0.88rem; font-weight: 700; margin-bottom: 4px; color: var(--text); }
    .feature-text span   { font-size: 0.8rem; color: var(--muted); line-height: 1.6; }

    /* ── SEO BULLET LIST ───────────────────── */
    .seo-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 16px 0; }
    .seo-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 0.94rem; color: var(--text-soft); line-height: 1.7; }
    .seo-list li::before { content: '✦'; color: var(--li); font-size: 0.6rem; flex-shrink: 0; margin-top: 6px; }
    .seo-list li strong { color: var(--text); font-weight: 600; }

    /* ── COMPARE TABLE ─────────────────────── */
    .compare-table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 0.83rem; }
    .compare-table thead tr { border-bottom: 1px solid var(--border); }
    .compare-table th { text-align: left; padding: 14px 16px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
    .compare-table th:first-child { color: var(--text); }
    .compare-table th.hi { color: var(--li-light); }
    .compare-table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.03); transition: background 0.2s; }
    .compare-table tbody tr:hover { background: rgba(132,204,22,0.03); }
    .compare-table tbody tr.hl { background: rgba(132,204,22,0.04); }
    .compare-table td { padding: 14px 16px; color: var(--text-soft); vertical-align: middle; }
    .compare-table td:first-child { font-weight: 600; color: var(--text); }

    .pill-yes  { display:inline-block; background:rgba(52,211,153,0.10);  color:#34d399; border:1px solid rgba(52,211,153,0.25); border-radius:100px; padding:2px 10px; font-size:0.68rem; font-weight:700; }
    .pill-part { display:inline-block; background:rgba(251,191,36,0.10);  color:#fbbf24; border:1px solid rgba(251,191,36,0.20); border-radius:100px; padding:2px 10px; font-size:0.68rem; font-weight:700; }
    .pill-no   { display:inline-block; background:rgba(248,113,113,0.08); color:#f87171; border:1px solid rgba(248,113,113,0.20); border-radius:100px; padding:2px 10px; font-size:0.68rem; font-weight:700; }
    .pill-li   { display:inline-block; background:var(--li-soft); color:var(--li-pale); border:1px solid var(--li-mid); border-radius:100px; padding:2px 10px; font-size:0.68rem; font-weight:700; }

    /* ── PRICING ───────────────────────────── */
    .pricing-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 20px; }
    .pricing-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 24px 18px; text-align: center;
      transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
    }
    .pricing-card.featured {
      border-color: rgba(132,204,22,0.32); background: var(--li-soft);
      box-shadow: 0 0 28px rgba(132,204,22,0.08);
    }
    .pricing-card:hover { border-color: rgba(132,204,22,0.28); transform: translateY(-3px); }
    .pricing-tier { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
    .pricing-card.featured .pricing-tier { color: var(--li-light); }
    .pricing-price {
      font-size: 1.55rem; font-weight: 800; letter-spacing: -0.03em;
      background: linear-gradient(135deg, #ecfccb, #84cc16);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; margin-bottom: 4px;
    }
    .pricing-cycle { font-size: 0.7rem; color: var(--muted); margin-bottom: 14px; }
    .pricing-features { list-style: none; text-align: left; }
    .pricing-features li { font-size: 0.74rem; color: var(--text-soft); padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.04); display: flex; align-items: center; gap: 7px; }
    .pricing-features li::before { content: '✦'; color: var(--li); font-size: 0.5rem; }

    /* ── SIDEBAR ───────────────────────────── */
    .sidebar-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px 24px; margin-bottom: 20px; }
    .sidebar-card h3 { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
    .quick-facts { display: flex; flex-direction: column; gap: 12px; }
    .quick-fact { display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
    .quick-fact:last-child { border-bottom: none; padding-bottom: 0; }
